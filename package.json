{
  "name": "puf-desktop-gui",
  "version": "1.0.0",
  "description": "A modern Electron desktop application for PUF (Physically Unclonable Function) analysis",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:renderer": "electron-vite build --renderer",
    "build:main": "electron-vite build --main",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "type-check:main": "tsc --noEmit --project tsconfig.main.json",
    "type-check:renderer": "tsc --noEmit --project tsconfig.renderer.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "postinstall": "electron-builder install-app-deps",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "puf",
    "analysis",
    "desktop",
    "typescript",
    "react"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@heroicons/react": "^2.2.0",
    "@mantine/core": "^8.1.3",
    "@mantine/hooks": "^8.1.3",
    "@mantine/notifications": "^8.1.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  },
  "build": {
    "appId": "com.puf-analyzer.desktop",
    "productName": "PUF GUI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "public/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../dram-puf-cli/target/pufmetrics-1.0-SNAPSHOT.jar",
        "to": "pufmetrics.jar"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/chip.png",
      "identity": null,
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "target": "nsis",
      "icon": "public/chip.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "public/chip.png"
    }
  }
}
